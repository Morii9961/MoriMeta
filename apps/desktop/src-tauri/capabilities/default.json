    "allow-plan-view",
    "allow-plan-page",
    "allow-plan-exclude",
    "allow-plan-exclude-field",
    "allow-plan-preflight",
    "allow-plan-confirm",
    "allow-op-execute",
    "allow-op-cancel",
    "allow-history-list",
    "allow-op-detail",
    "allow-undo-plan",
    "allow-retry-plan",
