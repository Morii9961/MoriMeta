{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoriMeta",
  "version": "0.1.0",
  "identifier": "org.morimeta.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoriMeta",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "backgroundColor": "#17191c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "windows": { "installMode": "passive" } }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
