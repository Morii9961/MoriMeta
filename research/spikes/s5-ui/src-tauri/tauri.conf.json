{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mm-s5-ui",
  "version": "0.0.0",
  "identifier": "dev.morimeta.s5spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "MoriMeta S5 spike (not product UI)", "width": 1440, "height": 900 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
